# ─────────────────────────────────────────────────
#  LearnBeam — Environment Variables
#  1. Copy this file:   cp .env.example .env.local
#  2. Fill in the values from your Supabase project:
#     Dashboard → Settings → API
# ─────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Spark AI runs through the Supabase Edge Function below.
# Set Gemini, Cerebras, Groq, NVIDIA, and/or TinyFish secrets in `supabase/functions/.env` locally
# and in your project's Edge Function secrets for production.
# Current backend routing:
# - Cerebras -> Groq -> NVIDIA -> Gemini for normal Spark text tasks
# - TinyFish + text-model chain for web-backed fact-checking when available
# - Gemini Search -> Groq browser search for grounded fact-check tasks
# - Gemini -> Groq for image/scanned syllabus tasks
VITE_SPARK_FUNCTION_NAME=spark-ai

# Optional local override for Spark during development.
# Example:
# VITE_SPARK_BASE_URL=http://127.0.0.1:54321/functions/v1

# Optional: Direct Gemini API key.
# When set, Spark will call Gemini directly from the browser if the Edge Function
# is unavailable (e.g. not yet deployed). Useful during development.
# NOTE: This key will be visible in the browser JS bundle — use only for personal/dev use.
# Get a key from: https://aistudio.google.com/app/apikey
# VITE_GEMINI_API_KEY=your-gemini-api-key-here
